#!/usr/bin/env python3
"""windowfiler: workspaces as manila folders, windows as filed sheets.

  windowfiler          open the overview, or close it if it is open
  windowfiler open     open it (e.g. three-finger swipe up)
  windowfiler close    close it and switch to the highlighted window

The folders stand side by side at the bottom of the screen, all turned to
one angle. The current workspace's folder stands higher with its windows
filed left to right, the highlighted one lifted. Click or scroll to leaf
through, click the lifted sheet to switch to it, drag a sheet onto another
folder to move the window to that workspace, click a folder to open it,
double-click to go there. Keys: Left/Right leaf, Enter opens, 1-9 and
PgUp/PgDn pick a folder, Esc leaves.

Nothing runs while it is closed. On opening, windows on the current
workspace are captured (scaled by the X server, one per frame after the
first); windows elsewhere are unmapped and get a generic preview instead.

X11 only (libwnck). Needs PyGObject, GTK 3, libwnck 3 and pycairo.
https://github.com/3-mmc/windowfiler — MIT licence.
"""
import math, os, signal, sys, time

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "windowfiler.pid")


def running_pid():
    try:
        pid = int(open(PIDFILE).read())
        if b"windowfiler" in open(f"/proc/{pid}/cmdline", "rb").read():
            return pid
    except (OSError, ValueError):
        pass
    return None


# Talk to an open overview before paying ~200 ms for the GTK imports.
if __name__ == "__main__":
    CMD = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if CMD == "--snapd":
        sys.exit(0)          # the old background thumbnailer is retired
    _pid = running_pid()
    if _pid:
        if CMD in ("toggle", "close"):
            os.kill(_pid, signal.SIGUSR1 if CMD == "close" else signal.SIGTERM)
        sys.exit(0)
    if CMD == "close":
        sys.exit(0)

